# ==============================================================================
# VaultSync Server Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your deployment
# environment (e.g., systemd service file or container manager).
#
# All variables are prefixed with VAULTSYNC_ and read automatically by the
# FastAPI server application via Pydantic Settings.
#
# SECURITY NOTICE:
# - Never commit a populated .env file containing live secrets to version control.
# - In production, VAULTSYNC_ENVIRONMENT=production enforces fail-closed checks
#   on secret keys and database URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Environment & Service Identity
# ------------------------------------------------------------------------------

# Operating environment: development, test, or production.
# In 'production', debug mode is disabled, strong secrets are enforced,
# and insecure default database paths are rejected.
# Default: development
VAULTSYNC_ENVIRONMENT=development

# Enable verbose application debugging.
# Set to false in production.
# Default: false
VAULTSYNC_DEBUG=false

# Application service metadata (displayed on /health and OpenAPI docs)
VAULTSYNC_APP_NAME="VaultSync Server"
VAULTSYNC_APP_VERSION="0.1.0"

# API URL prefix route
# Default: /api/v1
VAULTSYNC_API_V1_PREFIX=/api/v1


# ------------------------------------------------------------------------------
# Network & Server Binding
# ------------------------------------------------------------------------------

# IP address on which the backend server will listen.
# SECURITY REQUIREMENT:
# Always bind to 127.0.0.1 (localhost) or an isolated VPN/mesh interface (e.g. Tailscale/WireGuard).
# Never expose this server directly to the public internet (0.0.0.0) without an
# authenticating TLS reverse proxy (e.g. Nginx, Caddy).
# Default: 127.0.0.1
VAULTSYNC_HOST=127.0.0.1

# Port on which the backend server will listen.
# Default: 8000
VAULTSYNC_PORT=8000

# Trusted reverse proxy IP addresses.
# Only requests originating from these proxies are allowed to set 'X-Forwarded-Proto'
# or client IP headers for HSTS and rate-limiting evaluation.
# Provide as a JSON array string.
# Default: ["127.0.0.1", "::1"]
VAULTSYNC_TRUSTED_PROXIES=["127.0.0.1", "::1"]


# ------------------------------------------------------------------------------
# Database Storage Configuration
# ------------------------------------------------------------------------------

# SQLAlchemy database connection URL.
#
# Supported schemes:
#   - SQLite: sqlite:///path/to/database.db
#   - PostgreSQL: postgresql+psycopg2://user:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/vaultsync
#
# SAFETY NOTICE FOR DEVELOPMENT & TESTS:
# - The default development database is 'sqlite:///./vaultsync_dev.db'.
# - For automated tests, always use an isolated temporary path or pytest tmp_path.
# - In 'production', pointing to 'sqlite:///./vaultsync.db' or './vaultsync_dev.db'
#   will be rejected at startup. Use a dedicated system directory (e.g. /var/lib/vaultsync/vaultsync.db).
# Default: sqlite:///./vaultsync_dev.db
VAULTSYNC_DATABASE_URL=sqlite:///./vaultsync_dev.db


# ------------------------------------------------------------------------------
# Server Cryptographic Secrets
# ------------------------------------------------------------------------------

# Master secret key used for server-side cryptographic operations, including:
# - Deterministic synthetic salt derivation to prevent username enumeration on /api/v1/auth/salt.
#
# PRODUCTION REQUIREMENTS:
# - Must be AT LEAST 32 characters of high-entropy randomness.
# - Must NOT match any insecure development defaults.
# - If VAULTSYNC_ENVIRONMENT=production and this is missing or weak, the server WILL REFUSE TO START.
#
# How to generate a secure 64-character random hex string:
#   Using OpenSSL:
#     openssl rand -hex 32
#   Using Python:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Replace the placeholder below with your generated secret:
VAULTSYNC_SERVER_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32


# ------------------------------------------------------------------------------
# Session Policy & Authentication Rate Limiting
# ------------------------------------------------------------------------------

# Session lifetime in hours.
# After this period, client bearer tokens expire and require re-authentication.
# Default: 168 (7 days)
VAULTSYNC_SESSION_EXPIRY_HOURS=168

# Throttle interval in seconds for updating 'last_used_at' timestamps in the sessions table.
# Prevents excessive database write lock contention on high-frequency sync polls.
# Default: 300 (5 minutes)
VAULTSYNC_SESSION_LAST_USED_UPDATE_INTERVAL_SECONDS=300

# Maximum allowed failed authentication attempts from a single client IP within the rate-limit window.
# Exceeding this limit returns HTTP 429 Too Many Requests.
# Default: 10
VAULTSYNC_RATE_LIMIT_MAX_ATTEMPTS=10

# Evaluation window for authentication rate limiting in seconds.
# Default: 60 (1 minute)
VAULTSYNC_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum allowable HTTP request payload size in bytes.
# Enforces defense against memory exhaustion and large payload denial-of-service.
# Default: 2097152 (2 MiB)
VAULTSYNC_MAX_PAYLOAD_SIZE_BYTES=2097152
